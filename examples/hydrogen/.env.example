# From your Hydrogen storefront (Shopify admin → Hydrogen → your storefront → Environments and variables),
# or `npx shopify hydrogen env pull`. Only PUBLIC_* values may ever reach a browser.
SESSION_SECRET="replace-with-a-long-random-string"
PUBLIC_STORE_DOMAIN="your-shop.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
SHOP_ID=""
